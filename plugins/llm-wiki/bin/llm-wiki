#!/usr/bin/env python3
"""llm-wiki CLI.

Single source of truth for machine-local state and hook logic. Used by the
plugin's hooks AND by the operation commands (the model shells out to it). The
user never types it directly.

Self-locates the plugin root from its own path (this file lives at
<plugin_root>/bin/llm-wiki), so it needs NO environment variables -- it
works identically whether invoked by a hook or by the agent's Bash tool.

State (machine-local, outside any vault, so no gitignore needed):
  ~/.config/llm-wiki/config.json   {"vault_path": "..."}
  ~/.config/llm-wiki/topics.json   {"<abs-dir>": "<topic>", ...}

Subcommands:
  resolve                       (UserPromptSubmit hook; reads hook JSON on stdin)
  dep-check                     (SessionStart hook; reads hook JSON on stdin)
  context <cwd>                 print vault_path/topic/templates_path/etc. for a command
  run <command> -- <cwd> ['args']
                                run a hook-answered command; args is one string, split like a shell
  doctor <cwd>                  report environment, config, vault, and bindings
  merge-scan <from> <into>      classify <from>'s raw sources and pages against <into>
  log-commit <topic> <op> <title> [<body>]
                                append a log entry, commit only that topic, refresh qmd
  ingest <topic> --type T --title=X [--uri=U] [--slug=S] -- <path>
                                copy a source into raw/documents with a sidecar, log, commit
  init <cwd> <topic> [--description=TEXT]
                                scaffold a topic, commit, bind <cwd>, add the qmd collection
  topic-set <cwd> <name>
  topic-list
  config-set <key> <value>
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "llm-wiki"
CONFIG_FILE = CONFIG_DIR / "config.json"
TOPICS_FILE = CONFIG_DIR / "topics.json"

# Commands that may run without a topic bound for the cwd (bootstrap).
EXEMPT = {"init", "doctor", "merge", "list", "set-vault", "set-topic", "remove"}
PLUGIN_PREFIX = "llm-wiki:"
LOG_OPS = ("init", "ingest", "compile", "query", "lint", "merge")
EMBED_OPS = {"compile", "query", "lint", "merge"}


class CliError(Exception):
    pass


def plugin_root() -> Path:
    # <plugin_root>/bin/llm-wiki -> <plugin_root>
    return Path(os.path.realpath(__file__)).parent.parent


def references_dir() -> Path:
    return plugin_root() / "references"


def _load(path: Path) -> dict:
    try:
        data = json.loads(path.read_text())
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def _save(path: Path, data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")


def vault_path() -> str:
    return _load(CONFIG_FILE).get("vault_path", "")


def topic_for(cwd: str) -> str:
    # Exact-key lookup only. No walk-up, no prefix/subdir inheritance (plan C2).
    return _load(TOPICS_FILE).get(os.path.abspath(cwd), "")


def detect_command(prompt: str) -> str:
    if not prompt:
        return ""
    m = re.search(r"/?" + re.escape(PLUGIN_PREFIX) + r"([A-Za-z][\w-]*)", prompt)
    return m.group(1) if m else ""


def read_hook_input() -> dict:
    try:
        return json.loads(sys.stdin.read() or "{}")
    except Exception:
        return {}


def context_lines(cwd: str) -> str:
    refs = references_dir()
    return (
        f"vault_path={vault_path()}\n"
        f"topic={topic_for(cwd)}\n"
        f"templates_path={refs / 'templates'}\n"
        f"conventions_path={refs / 'conventions.md'}\n"
    )


UNCOMPILED = re.compile(r"^compiled:[ \t]*[\"']?false[\"']?[ \t]*$", re.M | re.I)


def _wiki_pages(topic_dir: Path) -> set:
    w = topic_dir / "wiki"
    return {str(f.relative_to(w)) for f in w.rglob("*.md") if f.name != "index.md"} if w.is_dir() else set()


def _topic_stats(topic_dir: Path) -> str:
    docs = topic_dir / "raw" / "documents"
    sources = uncompiled = 0
    files = [f for f in docs.iterdir() if f.is_file() and not f.name.startswith(".")] if docs.is_dir() else []
    for f in files:
        if not f.name.endswith(".meta.md"):
            sources += 1
            continue
        try:
            uncompiled += bool(UNCOMPILED.search(f.read_text(errors="ignore")))
        except OSError:
            pass
    return f"{sources} sources ({uncompiled} uncompiled), {len(_wiki_pages(topic_dir))} pages"


def topics_report(cwd: str) -> str:
    vault = vault_path()
    if not vault:
        return "No vault set. Run /llm-wiki:set-vault <path>."
    root = Path(vault)
    if not root.is_dir():
        return f"Vault path is not a directory: {vault}. Fix it with /llm-wiki:set-vault <path>."
    names = _topic_names(root)
    topics = _load(TOPICS_FILE)
    bindings: dict = {}
    for d, t in sorted(topics.items()):
        bindings.setdefault(t, []).append(d)
    current = topics.get(os.path.abspath(cwd), "")
    lines = [f"vault: {vault}"]
    if not names:
        lines.append("  (no topics; run /llm-wiki:init <topic>)")
    for name in names:
        mark = "*" if name == current else " "
        lines.append(f"{mark} {name} -- {_topic_stats(root / name)}")
        lines.extend(f"    bound: {d}" for d in bindings.get(name, []))
    for name in sorted(set(bindings) - set(names)):
        lines.append(f"! {name} -- missing from vault")
        lines.extend(f"    bound: {d}" for d in bindings[name])
    return "\n".join(lines)


SCAFFOLD = {"log.md", "CLAUDE.md", "qmd.yml", ".gitignore"}
HANDLED_DIRS = ("raw/documents", "raw/attachments", "wiki", "outputs/reports")


def _unquote(value: str) -> str:
    if len(value) < 2 or value[0] != value[-1] or value[0] not in "\"'":
        return value
    if value[0] == '"':
        try:
            return json.loads(value)
        except ValueError:
            pass
    return value[1:-1]


def _sidecar(doc: Path) -> dict:
    meta = doc.with_name(doc.stem + ".meta.md")
    fields = {"sidecar": meta.name if meta.exists() else ""}
    if meta.exists():
        for m in re.finditer(r"^([\w-]+):[ \t]*(.*?)\s*$", meta.read_text(errors="ignore"), re.M):
            fields.setdefault(m.group(1), _unquote(m.group(2)))
    return fields


def _norm_uri(uri: str) -> str:
    uri = uri.strip().lower().rstrip("/")
    return re.sub(r"^(https?://)?(dx\.)?doi\.org/", "", uri)


def _norm_title(title: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", title.lower()).strip()


def _sha256(f: Path) -> str:
    return hashlib.sha256(f.read_bytes()).hexdigest()


def _files(d: Path) -> list:
    return sorted(f for f in d.iterdir() if f.is_file() and not f.name.startswith(".")) if d.is_dir() else []


def _raw_sources(topic_dir: Path) -> dict:
    out = {}
    for f in _files(topic_dir / "raw" / "documents"):
        if f.name.endswith(".meta.md"):
            continue
        meta = _sidecar(f)
        out[f.name] = {
            "sha256": _sha256(f),
            "uri": _norm_uri(meta.get("source-uri", "")),
            "title": _norm_title(meta.get("title", "")),
            "sidecar": meta["sidecar"],
            "compiled": meta.get("compiled", ""),
        }
    return out


def _classify_raw(a: dict, b: dict, dst_names: set) -> list:
    by_hash = {v["sha256"]: k for k, v in b.items()}
    by_uri = {v["uri"]: k for k, v in b.items() if v["uri"]}
    by_title = {v["title"]: k for k, v in b.items() if v["title"]}
    rows = []
    for name, v in a.items():
        row = {"file": name, "sidecar": v["sidecar"], "compiled": v["compiled"]}
        if v["sha256"] in by_hash:
            row.update(status="duplicate", match=by_hash[v["sha256"]], basis="identical-bytes")
        elif v["uri"] in by_uri:
            row.update(status="possible-duplicate", match=by_uri[v["uri"]], basis="same-source-uri")
        elif v["title"] in by_title:
            row.update(status="possible-duplicate", match=by_title[v["title"]], basis="same-title")
        else:
            row.update(status="new")
        if "match" in row:
            row["match_sidecar"] = b[row["match"]]["sidecar"]
            row["match_compiled"] = b[row["match"]]["compiled"]
        row["name_clash"] = bool({name, v["sidecar"]} & dst_names)
        rows.append(row)
    return rows


def _unhandled(topic_dir: Path) -> list:
    out = []
    for f in sorted(topic_dir.rglob("*")):
        rel = f.relative_to(topic_dir).as_posix()
        if not f.is_file() or f.name.startswith(".") or ".sqlite" in f.name or rel in SCAFFOLD:
            continue
        if not any(rel.startswith(d + "/") for d in HANDLED_DIRS):
            out.append(rel)
    return out


def merge_scan(src: Path, dst: Path) -> dict:
    dst_names = {f.name for f in _files(dst / "raw" / "documents")}
    raw = _classify_raw(_raw_sources(src), _raw_sources(dst), dst_names)

    stems_b = {Path(p).stem: p for p in _wiki_pages(dst)}
    pages_new, pages_colliding = [], []
    for page in sorted(_wiki_pages(src)):
        stem = Path(page).stem
        if stem in stems_b:
            pages_colliding.append({"from": page, "into": stems_b[stem]})
        else:
            pages_new.append(page)

    attach_b = {f.name: _sha256(f) for f in _files(dst / "raw" / "attachments")}
    attachments = [
        {"file": f.name, "status": "new" if f.name not in attach_b
         else "identical" if attach_b[f.name] == _sha256(f) else "name-clash"}
        for f in _files(src / "raw" / "attachments")
    ]
    reports_b = {f.name for f in _files(dst / "outputs" / "reports")}
    return {
        "from": str(src),
        "into": str(dst),
        "raw": raw,
        "attachments": attachments,
        "pages_new": pages_new,
        "pages_colliding": pages_colliding,
        "reports_colliding": [f.name for f in _files(src / "outputs" / "reports") if f.name in reports_b],
        "unhandled": _unhandled(src),
    }


def cmd_merge_scan(argv: list) -> str:
    ap = argparse.ArgumentParser(prog="llm-wiki merge-scan")
    ap.add_argument("from_topic")
    ap.add_argument("into_topic")
    a = ap.parse_args(argv)
    root = _vault_root()
    src, dst = _require_topic(root, a.from_topic), _require_topic(root, a.into_topic)
    if src == dst:
        raise CliError("cannot merge a topic into itself")
    return json.dumps(merge_scan(src, dst), indent=2)


def _git(vault: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(vault), *args], capture_output=True, text=True)


def _is_git_repo(vault: Path) -> bool:
    if shutil.which("git") is None:
        return False
    top = _git(vault, "rev-parse", "--show-toplevel")
    return top.returncode == 0 and Path(top.stdout.strip()).resolve() == vault.resolve()


def _topic_names(vault: Path) -> list:
    if not vault.is_dir():
        return []
    return sorted(d.name for d in vault.iterdir() if not d.is_symlink() and (d / "wiki").is_dir())


def _topic_dir(vault: Path, name: str):
    return vault.resolve() / name if name in _topic_names(vault) else None


def _is_cache(path: str) -> bool:
    name = path.rstrip("/").rsplit("/", 1)[-1]
    return name == ".DS_Store" or ".sqlite" in name


def _bind(cwd: str, name: str) -> str:
    data = _load(TOPICS_FILE)
    data[os.path.abspath(cwd)] = name
    _save(TOPICS_FILE, data)
    return os.path.abspath(cwd)


def run_list(cwd: str, args: list) -> str:
    return topics_report(cwd)


def run_set_vault(cwd: str, args: list) -> str:
    if len(args) != 1:
        return "Usage: /llm-wiki:set-vault <path>"
    path = Path(cwd, os.path.expanduser(args[0])).resolve()
    try:
        path.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        return f"Cannot create {path}: {e}"
    _save(CONFIG_FILE, {**_load(CONFIG_FILE), "vault_path": str(path)})
    if shutil.which("git") and not _is_git_repo(path):
        _git(path, "init", "-q")
    return f"Vault set to {path}."


def run_set_topic(cwd: str, args: list) -> str:
    vault = vault_path()
    if not vault:
        return "No vault set. Run /llm-wiki:set-vault <path> first."
    names = _topic_names(Path(vault))
    if len(args) != 1:
        return "Usage: /llm-wiki:set-topic <topic>\nTopics: " + (", ".join(names) or "(none)")
    if args[0] not in names:
        return f"No topic '{args[0]}' in {vault}. Run /llm-wiki:init {args[0]} to create it."
    _bind(cwd, args[0])
    return f"This directory is now bound to topic '{args[0]}'."


def run_remove(cwd: str, args: list) -> str:
    if not args:
        return "Usage: /llm-wiki:remove <topic> [<topic> ...]"
    vault = vault_path()
    if not vault:
        return "No vault set."
    root = Path(vault).resolve()
    missing = [a for a in args if _topic_dir(root, a) is None]
    if missing:
        return "Nothing removed. No such topic: " + ", ".join(missing)
    names = sorted(set(args))
    if not _is_git_repo(root):
        return f"Nothing removed. {root} is not the root of a git repo, so the deletion would not be recoverable."
    status = _git(root, "status", "--porcelain", "-uall", "--ignored", "--", *names)
    if status.returncode != 0:
        return "Nothing removed. git status failed:\n" + status.stderr.strip()
    unsafe = [line for line in status.stdout.splitlines() if not (line.startswith("!! ") and _is_cache(line[3:]))]
    if unsafe:
        return "Nothing removed. Commit, discard, or move these files first:\n" + "\n".join(unsafe)
    head = _git(root, "rev-parse", "--short", "HEAD").stdout.strip()
    if not head:
        return "Nothing removed. The vault repo has no commits to recover from."

    for name in names:
        shutil.rmtree(root / name)
    notes = [qmd_run(name, "collection", "remove", name) for name in names]
    topics = _load(TOPICS_FILE)
    unbound = sorted(d for d, t in topics.items() if t in names)
    _save(TOPICS_FILE, {d: t for d, t in topics.items() if t not in names})
    try:
        commit_paths(root, names, "remove: " + ", ".join(names))
    except CliError as e:
        notes.append(str(e))
    notes = [n for n in notes if n]

    lines = ["Removed: " + ", ".join(names)]
    lines += [f"  unbound: {d}" for d in unbound]
    lines += [f"  warning: {n}" for n in notes]
    recover = ["git", "-C", str(root), "checkout", head, "--", *names]
    lines.append("Recover with: " + " ".join(shlex.quote(a) for a in recover))
    return "\n".join(lines)


def _today() -> str:
    return datetime.date.today().isoformat()


def _vault_root() -> Path:
    vault = vault_path()
    if not vault:
        raise CliError("no vault set; run /llm-wiki:set-vault <path>")
    root = Path(vault).resolve()
    if not _is_git_repo(root):
        raise CliError(f"{root} is not the root of a git repo")
    return root


def _require_topic(root: Path, name: str) -> Path:
    d = _topic_dir(root, name)
    if d is None:
        raise CliError(f"no topic '{name}' in {root}")
    return d


def append_log(topic_dir: Path, op: str, title: str, body: str = "") -> str:
    """Append an entry and return the previous log text, for rollback."""
    log = topic_dir / "log.md"
    before = log.read_text() if log.exists() else ""
    text = before if not before or before.endswith("\n") else before + "\n"
    body = " ".join(body.split())
    log.write_text(text + f"\n## [{_today()}] {op} | {' '.join(title.split())}\n" + (body + "\n" if body else ""))
    return before


def commit_paths(root: Path, paths: list, message: str) -> list:
    """Stage and commit only `paths`; return the committed file names."""
    added = _git(root, "add", "-A", "--", *paths)
    if added.returncode != 0:
        _git(root, "reset", "-q", "--", *paths)
        raise CliError("git add failed: " + added.stderr.strip())
    staged = _git(root, "diff", "--cached", "--name-only", "--", *paths)
    files = staged.stdout.split()
    if staged.returncode != 0 or not files:
        _git(root, "reset", "-q", "--", *paths)
        if staged.returncode != 0:
            raise CliError("git diff failed: " + staged.stderr.strip())
        return []
    result = _git(root, "commit", "-q", "-m", message, "--", *paths)
    if result.returncode != 0:
        _git(root, "reset", "-q", "--", *paths)
        raise CliError("git commit failed: " + (result.stderr or result.stdout).strip())
    return files


def _qmd_has(name: str) -> bool:
    listed = subprocess.run(["qmd", "collection", "list"], capture_output=True, text=True).stdout
    return f"\n{name} (qmd://" in "\n" + listed


def qmd_run(name: str, *args: str) -> str:
    """Run qmd for an existing collection; return a warning or ''."""
    if not shutil.which("qmd") or not _qmd_has(name):
        return ""
    result = subprocess.run(["qmd", *args], capture_output=True, text=True)
    if result.returncode == 0:
        return ""
    return f"warning: qmd {' '.join(args)} failed: " + (result.stderr or result.stdout).strip()[-300:]


def _log_commit(root: Path, topic_dir: Path, op: str, title: str, body: str = "") -> str:
    name = topic_dir.name
    before = append_log(topic_dir, op, title, body)
    message = f"{op}: {' '.join(title.split())}"
    try:
        files = commit_paths(root, [name], message)
    except CliError:
        (topic_dir / "log.md").write_text(before)
        raise
    head = _git(root, "rev-parse", "--short", "HEAD").stdout.strip()
    lines = [f"committed {head} {message}"]
    if op in EMBED_OPS and any(f.startswith(f"{name}/wiki/") for f in files):
        lines.append(qmd_run(name, "embed", "--collection", name))
    return "\n".join(line for line in lines if line)


def log_commit(name: str, op: str, title: str, body: str = "") -> str:
    root = _vault_root()
    return _log_commit(root, _require_topic(root, name), op, title, body)


def cmd_log_commit(argv: list) -> str:
    ap = argparse.ArgumentParser(prog="llm-wiki log-commit")
    ap.add_argument("topic")
    ap.add_argument("op", choices=LOG_OPS)
    ap.add_argument("title")
    ap.add_argument("body", nargs="?", default="")
    a = ap.parse_args(argv)
    return log_commit(a.topic, a.op, a.title, a.body)


SOURCE_TYPES = ("paper", "article", "standard", "conversation", "user-note")
MAX_SLUG = 60


def _slugify(text: str) -> str:
    slug = re.sub(r"[^a-z0-9.]+", "-", text.lower()).strip("-.")
    return slug[:MAX_SLUG].rstrip("-.") or "source"


def _yaml_str(value: str) -> str:
    return json.dumps(value, ensure_ascii=False) if value else ""


def _free_stem(docs: Path, stem: str, ext: str) -> str:
    candidate, n = stem, 1
    while (docs / f"{candidate}{ext}").exists() or (docs / f"{candidate}.meta.md").exists():
        n += 1
        candidate = f"{stem}-{n}"
    return candidate


def _sidecar_text(source_type: str, uri: str, file_name: str, title: str) -> str:
    return (
        "---\n"
        f"date: {_today()}\n"
        f"source-type: {source_type}\n"
        f"source-uri: {_yaml_str(uri)}\n"
        f"source-file: {file_name}\n"
        f"title: {_yaml_str(' '.join(title.split()))}\n"
        "compiled: false\n"
        "---\n"
    )


def ingest(name: str, src: Path, source_type: str, title: str, uri: str, slug: str) -> str:
    root = _vault_root()
    topic_dir = _require_topic(root, name)
    docs = topic_dir / "raw" / "documents"
    if not src.is_file():
        raise CliError(f"no such file: {src}")
    resolved = src.resolve()
    in_place = resolved.parent == docs.resolve()
    if in_place and slug:
        raise CliError("--slug cannot rename a file that is already in raw/documents")
    if not in_place and resolved.is_relative_to(topic_dir / "raw"):
        raise CliError(f"{src} is under raw/ but not in raw/documents; move it there first")
    if in_place:
        target = resolved
        if (docs / f"{target.stem}.meta.md").exists():
            raise CliError(f"{target.name} already has a sidecar")
    else:
        ext = resolved.suffix.lower()
        target = docs / f"{_free_stem(docs, f'{_today()}-{_slugify(slug or resolved.stem)}', ext)}{ext}"
        if not uri and not resolved.is_relative_to(root):
            uri = os.path.abspath(src)
    sidecar = docs / f"{target.stem}.meta.md"
    created = []
    try:
        if not in_place:
            docs.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(resolved, target)
            created.append(target)
        sidecar.write_text(_sidecar_text(source_type, uri, target.name, title))
        created.append(sidecar)
        return _log_commit(root, topic_dir, "ingest", title, f"{source_type} -> raw/documents/{target.name}")
    except Exception:
        for f in created:
            f.unlink(missing_ok=True)
        raise


def cmd_ingest(argv: list) -> str:
    ap = argparse.ArgumentParser(prog="llm-wiki ingest")
    ap.add_argument("topic")
    ap.add_argument("path", type=Path)
    ap.add_argument("--type", required=True, choices=SOURCE_TYPES)
    ap.add_argument("--title", required=True)
    ap.add_argument("--uri", default="")
    ap.add_argument("--slug", default="")
    a = ap.parse_args(argv)
    return ingest(a.topic, a.path, a.type, a.title, a.uri, a.slug)


def _template(name: str, topic: str) -> str:
    text = (references_dir() / "templates" / name).read_text()
    return text.replace("<topic>", topic).replace("Last updated: YYYY-MM-DD", f"Last updated: {_today()}")


CLAUDE_MD = """# {topic} wiki

{description}

Page templates and conventions are provided by the llm-wiki plugin and injected
by the resolution hook; topic-specific overrides, if any, go below.
"""
DESCRIPTION_PLACEHOLDER = "<!-- domain description: one paragraph -->"


TOPIC_NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")
TOPIC_DIRS = ("raw/documents", "raw/attachments", "wiki/queries", "outputs/reports")
TOPIC_GITIGNORE = ".DS_Store\n*.sqlite\n*.sqlite-wal\n*.sqlite-shm\n"


def _scaffold(topic_dir: Path, name: str, description: str) -> None:
    for sub in TOPIC_DIRS:
        (topic_dir / sub).mkdir(parents=True)
    (topic_dir / "wiki" / "index.md").write_text(_template("index.md", name))
    (topic_dir / "log.md").write_text(_template("log.md", name))
    (topic_dir / "qmd.yml").write_text(
        f'collections:\n  {name}:\n    path: ./wiki\n    pattern: "**/*.md"\n'
    )
    (topic_dir / ".gitignore").write_text(TOPIC_GITIGNORE)
    (topic_dir / "CLAUDE.md").write_text(
        CLAUDE_MD.format(topic=name, description=description.strip() or DESCRIPTION_PLACEHOLDER)
    )


def init_topic(cwd: str, name: str, description: str) -> str:
    vault = vault_path()
    if not vault:
        raise CliError("no vault set; run /llm-wiki:set-vault <path>")
    if not TOPIC_NAME.fullmatch(name):
        raise CliError(f"topic name '{name}' must be lowercase kebab-case")
    if shutil.which("git") is None:
        raise CliError("git is required")
    root = Path(vault).resolve()
    topic_dir = root / name
    if topic_dir.exists() or topic_dir.is_symlink():
        raise CliError(f"{topic_dir} already exists; use /llm-wiki:remove {name} first")
    root.mkdir(parents=True, exist_ok=True)
    if not _is_git_repo(root):
        _git(root, "init", "-q")
    if not _is_git_repo(root):
        raise CliError(f"git init failed in {root}")
    try:
        _scaffold(topic_dir, name, description)
        lines = [_log_commit(root, topic_dir, "init", f"{name} wiki",
                             "Scaffolded raw/wiki/outputs, index, log, qmd.yml, CLAUDE.md.")]
    except Exception:
        shutil.rmtree(topic_dir, ignore_errors=True)
        raise
    try:
        lines.append(f"Bound {_bind(cwd, name)} -> {name}")
    except OSError as e:
        raise CliError(f"topic {name} was created but not bound ({e}); run /llm-wiki:set-topic {name}")
    lines.append(_qmd_index(topic_dir))
    if not description.strip():
        lines.append(f"CLAUDE.md needs a domain description: {topic_dir / 'CLAUDE.md'}")
    lines.append("Next: /llm-wiki:ingest <path|url>")
    return "\n".join(line for line in lines if line)


def _qmd_index(topic_dir: Path) -> str:
    name = topic_dir.name
    if not shutil.which("qmd"):
        return ""
    if not _qmd_has(name):
        added = subprocess.run(["qmd", "collection", "add", str(topic_dir / "wiki"), "--name", name],
                               capture_output=True, text=True)
        if added.returncode != 0:
            return f"warning: qmd collection add {name} failed: " + (added.stderr or added.stdout).strip()[-300:]
    embedded = subprocess.run(["qmd", "embed", "--collection", name], capture_output=True, text=True)
    if embedded.returncode != 0:
        return f"warning: qmd embed {name} failed: " + (embedded.stderr or embedded.stdout).strip()[-300:]
    return ""


def cmd_init(argv: list) -> str:
    ap = argparse.ArgumentParser(prog="llm-wiki init")
    ap.add_argument("cwd")
    ap.add_argument("topic")
    ap.add_argument("--description", default="")
    a = ap.parse_args(argv)
    return init_topic(a.cwd, a.topic, a.description)


HOOK_ANSWERED = {
    "list": run_list,
    "set-vault": run_set_vault,
    "set-topic": run_set_topic,
    "remove": run_remove,
}


def _split_args(text: str) -> list:
    try:
        return shlex.split(text)
    except ValueError:
        return text.split()


def _parse_args(prompt: str, command: str) -> list:
    return _split_args(prompt.lstrip()[len("/" + PLUGIN_PREFIX + command):])


def doctor_report(cwd: str) -> str:
    def item(ok: bool, label: str, hint: str = "") -> str:
        return f"{'OK     ' if ok else 'MISSING'} {label}" + (f" -- {hint}" if hint and not ok else "")

    lines = [
        item(bool(shutil.which("qmd")), "qmd", "optional; search falls back to index.md. Install: npm i -g @tobilu/qmd"),
        item(bool(shutil.which("git")), "git", "required for commits and recovery"),
    ]
    lines += config_check_lines()
    vault = vault_path()
    root = Path(vault) if vault else None
    lines.append(item(bool(vault), f"vault_path={vault}", "run /llm-wiki:set-vault <path>"))
    if root:
        lines.append(item(root.is_dir(), "vault directory exists", "run /llm-wiki:set-vault <path>"))
        lines.append(item(root.is_dir() and _is_git_repo(root), "vault is a git repo", f"run git -C {root} init"))
    topic = topic_for(cwd)
    lines.append(item(bool(topic), f"topic for {os.path.abspath(cwd)}: {topic or '(none)'}",
                      "run /llm-wiki:set-topic <topic>"))
    if root and topic:
        lines.append(item(_topic_dir(root, topic) is not None, f"topic '{topic}' exists in vault",
                          f"run /llm-wiki:init {topic} or /llm-wiki:set-topic <topic>"))
    if root:
        lines += ["", topics_report(cwd)]
    return "\n".join(lines)


# ---- subcommands ----------------------------------------------------------

def config_check_lines() -> list:
    """Reachability + integrity of the config store (distinguishes missing
    from corrupt; reports writability needed by set-vault/set-topic/init)."""
    lines = [f"config_dir={CONFIG_DIR}"]
    if CONFIG_DIR.exists():
        lines.append(f"  dir=exists writable={'yes' if os.access(CONFIG_DIR, os.W_OK) else 'NO'}")
    else:
        lines.append(f"  dir=missing (created on first write; "
                     f"parent writable={'yes' if os.access(CONFIG_DIR.parent, os.W_OK) else 'NO'})")
    for label, path in (("config.json", CONFIG_FILE), ("topics.json", TOPICS_FILE)):
        if not path.exists():
            lines.append(f"  {label}=absent")
            continue
        try:
            data = json.loads(path.read_text())
        except Exception as e:
            lines.append(f"  {label}=INVALID ({e.__class__.__name__})")
            continue
        if not isinstance(data, dict):
            lines.append(f"  {label}=INVALID (not a JSON object)")
            continue
        lines.append(f"  {label}=ok ({len(data)} keys)")
    return lines


def cmd_resolve(argv: list):
    data = read_hook_input()
    prompt = data.get("prompt", "")
    cwd = data.get("cwd") or os.getcwd()
    command = detect_command(prompt)
    if not command:
        return None  # not a wiki command -> no-op, stay silent

    if command in HOOK_ANSWERED and prompt.lstrip().startswith("/" + PLUGIN_PREFIX + command):
        try:
            report = HOOK_ANSWERED[command](cwd, _parse_args(prompt, command))
        except Exception as e:
            report = f"/{PLUGIN_PREFIX}{command} failed: {e.__class__.__name__}: {e}"
        if report is not None:
            return json.dumps({"decision": "block", "reason": report})

    topic = topic_for(cwd)
    if command not in EXEMPT and not topic:
        # Hard guard: stop the prompt until a topic is bound.
        return json.dumps({
            "decision": "block",
            "reason": (
                f"No llm-wiki topic is set for this directory ({cwd}).\n"
                f"Run /llm-wiki:set-topic <name> to bind it, "
                f"or /llm-wiki:init <name> to create a new wiki here."
            ),
        })

    conventions = ""
    conv_file = references_dir() / "conventions.md"
    try:
        conventions = conv_file.read_text()
    except Exception:
        pass

    additional = (
        "llm-wiki active context (resolved deterministically; trust these):\n"
        + context_lines(cwd)
        + ("\n--- conventions ---\n" + conventions if conventions else "")
    )
    return json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": additional,
        }
    })


def cmd_dep_check(argv: list):
    read_hook_input()  # drain stdin; content unused
    if shutil.which("qmd"):
        return None  # present -> silent
    msg = ("llm-wiki: qmd not found on PATH. Search falls back to index.md "
           "(no vector search). Install with: npm i -g @tobilu/qmd")
    return json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": msg,
            "systemMessage": msg,
        }
    })




def _one_parser(name: str, *args: str) -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog=f"llm-wiki {name}")
    for arg in args:
        ap.add_argument(arg)
    return ap


def cmd_context(argv: list) -> str:
    return context_lines(_one_parser("context", "cwd").parse_args(argv).cwd).rstrip("\n")


def cmd_doctor(argv: list) -> str:
    return doctor_report(_one_parser("doctor", "cwd").parse_args(argv).cwd)


def cmd_run(argv: list) -> str:
    ap = _one_parser("run", "command", "cwd")
    ap.add_argument("args", nargs="?", default="")
    a = ap.parse_args(argv)
    if a.command not in HOOK_ANSWERED:
        raise CliError(f"'{a.command}' is not hook-answered")
    report = HOOK_ANSWERED[a.command](a.cwd, _split_args(a.args))
    if report is None:
        raise CliError(f"'{a.command}' needs the model for these arguments")
    return report


def cmd_topic_set(argv: list) -> str:
    a = _one_parser("topic-set", "cwd", "topic").parse_args(argv)
    return f"Bound {_bind(a.cwd, a.topic)} -> {a.topic}"


def cmd_topic_list(argv: list) -> str:
    _one_parser("topic-list").parse_args(argv)
    return "\n".join(f"{k}\t{v}" for k, v in sorted(_load(TOPICS_FILE).items()))


def cmd_config_set(argv: list) -> str:
    a = _one_parser("config-set", "key", "value").parse_args(argv)
    data = _load(CONFIG_FILE)
    data[a.key] = a.value
    _save(CONFIG_FILE, data)
    return f"{a.key}={a.value}"


ACTIONS = {
    "resolve": cmd_resolve,
    "dep-check": cmd_dep_check,
    "context": cmd_context,
    "run": cmd_run,
    "doctor": cmd_doctor,
    "merge-scan": cmd_merge_scan,
    "log-commit": cmd_log_commit,
    "ingest": cmd_ingest,
    "init": cmd_init,
    "topic-set": cmd_topic_set,
    "topic-list": cmd_topic_list,
    "config-set": cmd_config_set,
}


def main(argv) -> int:
    if not argv or argv[0] not in ACTIONS:
        sys.stderr.write(__doc__)
        return 2
    try:
        out = ACTIONS[argv[0]](argv[1:])
    except CliError as e:
        sys.stderr.write(f"llm-wiki: {e}\n")
        return 1
    if out:
        print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
