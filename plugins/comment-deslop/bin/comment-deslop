#!/usr/bin/env python3
"""comment-deslop: report AI comment slop on the lines you just changed.

Tree-sitter answers what is a comment and what code sits next to it; git answers
which of them this session is accountable for. The two are intersected on line
numbers: a comment is in scope when any of its lines changed since the diff base.
The whole file is always parsed from disk (the hook runs PostToolUse, so disk and
diff agree), so adjacency context is never a truncated fragment.

Detection only -- it never edits a source file, and it never calls a model.
tree-sitter is optional: without it the lexer runs and the four AST rules
(flow-narration adjacency, budget, redundant-docstring, plus evidence-cited
restatement) degrade or drop out.

Usage:
  comment-deslop [options] [paths...]
  comment-deslop --hook              (tool payload JSON on stdin)
  comment-deslop doctor              (report parser/git availability)
  comment-deslop doctor --install    (create the parser venv; opt-in, never automatic)
  comment-deslop eval                (labeled corpus + per-kind floors)

Options:
  --hook             read the edited file path from Claude Code hook JSON on stdin
  --since REF        diff base for change scoping (default: HEAD)
  --all              report every line, not only those changed since the base
  --json             emit findings as JSON instead of a text report
  --rules LIST       run only these comma-separated rule ids
  --no-rules LIST    disable these comma-separated rule ids
  --advisory LIST    advisory ids to note (or `all`); default: dead-code,
                     untracked-todo,banner. Advisories never affect the exit
                     code and never reach the model -- the user decides
  --no-advisory      emit no advisory notes at all
  --llm              print the triage candidate set as JSON (short unmatched
                     comments plus the adjacent code line) and exit 0. The
                     agent judges them -- this makes no model call and is not
                     available to the hook
  --list-rules       print the rule ids and exit
  -h, --help         show this help

Exit codes:
  0  clean, unsupported path, or internal failure (never breaks the edit loop)
  2  findings reported
  3  COMMENT_DESLOP_REQUIRE_AST=1 was set and no parser could be loaded, so the
     caller should try the next interpreter instead of accepting a silent
     downgrade to the lexer
"""

import argparse
import bisect
import contextlib
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from enum import Enum
from pathlib import Path

VERBOSE_WORDS = 30
VERBOSE_LINES = 3
VERBOSE_LINE_MIN_WORDS = 12
DOC_VERBOSE_WORDS = 90
DOC_VERBOSE_LINES = 10
SHELL_DENSITY_CEILING = 0.40
DENSITY_MIN_REGION = 8
RESTATE_COVERAGE = 0.6
TERSE_COVERAGE = 0.5
TERSE_WORDS = 3
FLOW_COVERAGE = 0.6
RESTATE_MAX_WORDS = 12
FLOW_MAX_WORDS = 10
CONDITIONAL_MAX_WORDS = 12
BARE_MAX_TOKENS = 3
DOCSTRING_MAX_WORDS = 15
SMALL_FN_LINES = 10


class Syntax(Enum):
    HASH = "hash"
    SLASH = "slash"
    SHELL = "shell"
    DASH = "dash"


class Kind(Enum):
    LINE = "line"
    BLOCK = "block"
    DOC = "doc"


@dataclass(frozen=True)
class Lang:
    name: str
    syntax: Syntax
    ts_name: str | None
    docstrings: bool = False


LANGS = {
    ".py": Lang("python", Syntax.HASH, "python", docstrings=True),
    ".pyi": Lang("python", Syntax.HASH, "python", docstrings=True),
    ".js": Lang("javascript", Syntax.SLASH, "javascript"),
    ".jsx": Lang("javascript", Syntax.SLASH, "javascript"),
    ".mjs": Lang("javascript", Syntax.SLASH, "javascript"),
    ".cjs": Lang("javascript", Syntax.SLASH, "javascript"),
    ".tsx": Lang("tsx", Syntax.SLASH, "tsx"),
    ".ts": Lang("typescript", Syntax.SLASH, "typescript"),
    ".mts": Lang("typescript", Syntax.SLASH, "typescript"),
    ".cts": Lang("typescript", Syntax.SLASH, "typescript"),
    ".rs": Lang("rust", Syntax.SLASH, "rust"),
    ".go": Lang("go", Syntax.SLASH, "go"),
    ".c": Lang("c", Syntax.SLASH, "c"),
    ".h": Lang("c", Syntax.SLASH, "c"),
    ".cc": Lang("cpp", Syntax.SLASH, "cpp"),
    ".cpp": Lang("cpp", Syntax.SLASH, "cpp"),
    ".cxx": Lang("cpp", Syntax.SLASH, "cpp"),
    ".hh": Lang("cpp", Syntax.SLASH, "cpp"),
    ".hpp": Lang("cpp", Syntax.SLASH, "cpp"),
    ".java": Lang("java", Syntax.SLASH, "java"),
    ".lua": Lang("lua", Syntax.DASH, "lua"),
    ".sh": Lang("shell", Syntax.SHELL, "bash"),
    ".bash": Lang("shell", Syntax.SHELL, "bash"),
    ".zsh": Lang("shell", Syntax.SHELL, "bash"),
    ".ksh": Lang("shell", Syntax.SHELL, "bash"),
    ".yml": Lang("yaml", Syntax.HASH, "yaml"),
    ".yaml": Lang("yaml", Syntax.HASH, "yaml"),
    ".toml": Lang("toml", Syntax.HASH, "toml"),
    ".dockerfile": Lang("dockerfile", Syntax.HASH, "dockerfile"),
}

DOCKERFILE_NAMES = ("dockerfile", "containerfile")


def lang_for(path: str) -> Lang | None:
    name = os.path.basename(path).lower()
    for stem in DOCKERFILE_NAMES:
        if name == stem or name.startswith(stem + "."):
            return LANGS[".dockerfile"]
    return LANGS.get(os.path.splitext(name)[1])


@dataclass
class Comment:
    line: int
    end_line: int
    kind: Kind
    raw: str
    prose: str
    trailing: bool
    next_code: str = ""
    prev_code: str = ""
    next_node: str = ""
    fn: int | None = None
    run: int = -1
    header: bool = False


@dataclass
class Unit:
    index: int
    name: str
    params: tuple[str, ...]
    start: int
    end: int
    body_lines: int
    doc: Comment | None = None
    comments: list[Comment] = field(default_factory=list)


@dataclass
class Finding:
    line: int
    rule: str
    text: str
    why: str
    end_line: int = 0
    code: str = ""
    extra: tuple[str, ...] = ()
    ident: str = ""

    @property
    def span(self) -> str:
        if self.end_line > self.line:
            return f"L{self.line}-{self.end_line}"
        return f"L{self.line}"


NEVER = (
    r"^#!",
    r"-\*-\s*coding",
    r"\b(noqa|nosec|nolint|NOSONAR|pragma|pylint:|mypy:|ruff:|flake8:|isort:|coverage:)",
    r"\btype:\s*ignore\b",
    r"\b(eslint-|prettier-ignore|@ts-ignore|@ts-expect-error|@ts-nocheck|tslint:)",
    r"\bshellcheck\s+(disable|source)\b",
    r"\b(clippy::|rustfmt::|#\[|golangci|go:generate|go:build|nolintlint)",
    r"\bfmt:\s*(on|off)\b",
    r"\bSPDX-License-Identifier\b",
    r"\b(Copyright|Licensed under|All rights reserved)\b",
    r"\b(TODO|FIXME|HACK|XXX|NOTE|SAFETY|SECURITY|PERF|WARNING|BUG)\b",
    r"https?://",
    r"\b[A-Z][A-Z0-9]{1,9}-\d+\b",
    r"^\s*(given|when|then|arrange|act|assert)\b\s*[:.-]?\s*$",
    r"^\s*(type:|:param|:return|:rtype|:raises)",
    r"^\s*@(param|returns?|throws?|example|deprecated|see|typedef|template|override)\b",
    r"^\s*(Args|Arguments|Returns|Yields|Raises|Attributes|Parameters|Examples?)\s*:?\s*$",
    r"^\s*#\s*(Safety|Panics|Errors|Examples)\s*$",
    r"^\s*\.{3}\s*$",
    r"^[\s\-=*_~#+.\u2500-\u257f]*$",
    r"^-{3,}|^={3,}|-{3,}\s*$|={3,}\s*$",
    r"[\u2500-\u257f]{3,}",
)

NEVER_OVERRIDE = (
    r"\brevisit\b",
    r"\bfor now\b",
    r"\bkept? for (backward|backwards|back-?compat)",
    r"\balternatives? considered\b",
    r"\bchose \w+ over \w+",
)

CITATION = r"\b(?:doi:|10\.\d{4,}/|arxiv|rfc\s*\d+|3gpp\s+t[sr]|ieee\s+\d|iso\s+\d|etsi)\b"

NEVER_RE = re.compile("|".join(NEVER))
CITATION_RE = re.compile(CITATION, re.IGNORECASE)
NEVER_OVERRIDE_RE = re.compile("|".join(NEVER_OVERRIDE), re.IGNORECASE)
EMOJI_RE = re.compile(
    "[\U0001f000-\U0001faff☀-➿⬀-⯿️←-⇿]"
)


def is_allowed(prose: str, raw: str) -> bool:
    if CITATION_RE.search(prose):
        return True
    if NEVER_OVERRIDE_RE.search(prose):
        return False
    return bool(NEVER_RE.search(raw)) or bool(NEVER_RE.search(prose))


PRESCRIBED = re.compile(
    r"^\s*(?:@(?:param|returns?|throws?|example|deprecated|see|typedef|template)\b"
    r"|(?:Args|Arguments|Parameters|Returns|Yields|Raises|Attributes|Examples?|Type"
    r"|Other Parameters|See Also|References)\s*:?\s*$"
    r"|#\s*(?:Safety|Panics|Errors|Examples)\s*$"
    r"|-{3,}\s*$|={3,}\s*$)",
    re.MULTILINE,
)

FREE_SECTIONS = re.compile(
    r"^\s*(?:Notes?|Warnings?|Remarks?|Description|Summary)\s*:?\s*$", re.IGNORECASE
)

MARKER_STRIP = re.compile(r"^\s*(?://+[!/]?|#+:?|/\*+|\*+/?|--+\[?\[?|--+|\"\"\"|''')")
MARKER_TAIL = re.compile(r"(?:\*/|\]\]|\"\"\"|''')\s*$")


def to_prose(raw: str, kind: Kind) -> str:
    lines = []
    for line in raw.splitlines():
        line = MARKER_TAIL.sub("", MARKER_STRIP.sub("", line)).strip()
        lines.append(line)
    text = "\n".join(lines).strip()
    if kind is not Kind.DOC:
        return text
    return doc_prose(text)


def doc_prose(text: str) -> str:
    kept, budgeted = [], True
    for line in text.splitlines():
        if FREE_SECTIONS.match(line):
            budgeted = True
            continue
        if PRESCRIBED.match(line):
            budgeted = False
            continue
        if budgeted:
            kept.append(line)
    return "\n".join(kept).strip()


def prose_lines(prose: str) -> int:
    return len([line for line in prose.splitlines() if line.strip()])


def word_count(prose: str) -> int:
    return len(re.findall(r"[A-Za-z][A-Za-z'_-]*", prose))


STOPWORD_TEXT = """a an the this that these those is are was were be been being do does did
    of to in on at for from with by as into over per and or not no if then else
    it its we our you your they their he she i me my us all any each every some
    here there now new old just also only very much many more most less least
    so but than which who whom whose what when where why how one two both
    same other another such own too can will would should could may might must
    have has had get gets got make makes made use uses used using via out up
    down off again further once about above below between through during before
    after until while because since although though unless whether"""

STOPWORDS = frozenset(STOPWORD_TEXT.split())

VERB_MAP = {
    r"\+=|\+\+": ("increment", "increase", "add", "bump", "advance", "count"),
    r"-=|--": ("decrement", "decrease", "subtract", "reduce", "lower"),
    r"\*=": ("multiply", "scale", "double"),
    r"/=|//=": ("divide", "halve"),
    r"\breturn\b": ("return", "returns", "give", "yield", "produce"),
    r"\b(raise|throw|panic)\b": ("raise", "throw", "error", "fail", "panic"),
    r"\b(import|require|include|use)\b": ("import", "require", "include", "load"),
    r"\b(del|delete|remove|pop|unset)\b": ("delete", "remove", "drop", "clear"),
    r"\.append\(|\.push\(|\.add\(|\.insert\(": ("append", "add", "push", "insert"),
    r"\.(open|read|write|close)\(|\bopen\(": ("open", "read", "write", "close"),
    r"\b(def|fn|func|function)\b": ("define", "helper", "function"),
    r"\b(class|struct|impl)\b": ("class", "define", "struct"),
    r"\b(await|async)\b": ("await", "async", "wait"),
    r"\b(sort|sorted)\b": ("sort", "order"),
    r"\b(len|count|size)\b": ("length", "count", "size"),
    r"=(?!=)": ("set", "assign", "initialize", "init", "create", "store", "build"),
}

FLOW_NODES = {
    "for": ("for", "loop", "loops", "iterate", "iterates", "each", "through", "over"),
    "while": ("while", "loop", "loops", "until", "repeat"),
    "if": ("if", "check", "checks", "whether", "guard", "handle", "case", "when"),
    "try": ("try", "catch", "except", "error", "errors", "exception", "handle"),
    "switch": ("switch", "match", "case", "dispatch", "branch"),
    "with": ("with", "context", "open", "scope"),
}

FLOW_KEYWORDS = {
    "for": "for",
    "while": "while",
    "if": "if",
    "elif": "if",
    "try": "try",
    "switch": "switch",
    "match": "switch",
    "with": "with",
    "foreach": "for",
    "unless": "if",
}

JUSTIFY_RE = re.compile(
    r"\b(because|since|so that|otherwise|avoids?|workaround|upstream|spec|rfc"
    r"|required by|must|cannot|does not|doesn't|intentional|deliberate|invariant"
    r"|assumes?|guarantees?|beware|caveat|bug in|limitation)\b",
    re.IGNORECASE,
)


CONSTRAINT_SYSTEM = (
    r"\b(protocol|spec|specification|standard|firmware|hardware|kernel|driver"
    r"|vendor|upstream|api|wire|broker|server|browser|compiler|linker|scheduler"
    r"|allocator|register|peripheral|device|grammar|schema|codec|format)\b"
)
CONSTRAINT_VERB = (
    r"\b(caps?|capped|limits?|limited|requires?|required|rejects?|expects?"
    r"|mandates?|forbids?|disallows?|guarantees?|reserves?|fixes|pins|only"
    r"|at most|at least|no more than)\b"
)
CONSTRAINT_RE = re.compile(f"(?=.*{CONSTRAINT_SYSTEM})(?=.*{CONSTRAINT_VERB})", re.IGNORECASE | re.DOTALL)


def content_words(prose: str) -> list[str]:
    words = [w.lower() for w in re.findall(r"[A-Za-z][A-Za-z'_-]*", prose)]
    return [w for w in words if w not in STOPWORDS and len(w) > 1]


def code_tokens(code: str) -> set[str]:
    tokens = set()
    for ident in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", code):
        tokens.add(ident.lower())
        parts = re.split(r"_+|(?<=[a-z0-9])(?=[A-Z])", ident)
        for part in parts:
            if len(part) > 2:
                tokens.add(part.lower())
    return tokens


def verb_hits(code: str) -> set[str]:
    hits = set()
    for pattern, words in VERB_MAP.items():
        if re.search(pattern, code):
            hits.update(words)
    return hits


def stem(word: str) -> str:
    for suffix in ("ing", "ies", "ed", "es", "s"):
        if len(word) > len(suffix) + 2 and word.endswith(suffix):
            return word[: -len(suffix)]
    return word


def matches_token(word: str, tokens: set[str]) -> str | None:
    if word in tokens:
        return word
    root = stem(word)
    for token in tokens:
        if root == stem(token):
            return token
    return None


TRIPLES = ('"""', "'''")
HEREDOC_RE = re.compile(r"<<-?\s*[\"']?([A-Za-z_][A-Za-z0-9_]*)[\"']?")
DEF_RE = re.compile(r"^\s*(async\s+def|def|class)\b")


class Scanner:
    def __init__(self, src: str, lang: Lang):
        self.lines = src.splitlines()
        self.lang = lang
        self.out: list[Comment] = []
        self.block: tuple[str, bool, int, list[str]] | None = None
        self.heredoc: str | None = None

    def scan(self) -> list[Comment]:
        for number, line in enumerate(self.lines, start=1):
            if self.block is not None:
                self.continue_block(number, line)
                continue
            if self.heredoc is not None:
                if line.strip() == self.heredoc:
                    self.heredoc = None
                continue
            self.scan_line(number, line)
        self.close_block(len(self.lines))
        return self.out

    def continue_block(self, number: int, line: str) -> None:
        closer, _, _, body = self.block
        end = line.find(closer)
        if end < 0:
            body.append(line)
            return
        body.append(line[: end + len(closer)])
        self.close_block(number)
        self.scan_line(number, line[end + len(closer):], offset=end + len(closer))

    def close_block(self, number: int) -> None:
        if self.block is None:
            return
        _, is_comment, start, body = self.block
        self.block = None
        if not is_comment:
            self.note_string(start, number, "\n".join(body))
            return
        raw = "\n".join(body)
        kind = Kind.DOC if raw.lstrip().startswith("/**") else Kind.BLOCK
        self.add(start, number, kind, raw, trailing=False)

    def note_string(self, start: int, end: int, raw: str) -> None:
        if not self.lang.docstrings:
            return
        previous = self.previous_code(start)
        if not DEF_RE.match(previous) and not (start == 1 or not previous):
            return
        if previous and not previous.rstrip().endswith(":"):
            return
        self.add(start, end, Kind.DOC, raw, trailing=False)

    def previous_code(self, start: int) -> str:
        for index in range(start - 2, -1, -1):
            if self.lines[index].strip():
                return self.lines[index]
        return ""

    def add(self, start: int, end: int, kind: Kind, raw: str, trailing: bool) -> None:
        self.out.append(
            Comment(
                line=start,
                end_line=end,
                kind=kind,
                raw=raw,
                prose=to_prose(raw, kind),
                trailing=trailing,
            )
        )

    def scan_line(self, number: int, text: str, offset: int = 0) -> None:
        index = 0
        while index < len(text):
            char = text[index]
            if char == "\\":
                index += 2
                continue
            if char in "\"'`":
                index = self.skip_string(number, text, index, offset)
                continue
            marker = self.comment_at(text, index, offset)
            if marker is not None:
                self.open_comment(number, text, index, offset, marker)
                return
            if self.lang.syntax is Syntax.SHELL:
                match = HEREDOC_RE.match(text, index)
                if match is not None:
                    self.heredoc = match.group(1)
                    index = match.end()
                    continue
            index += 1

    def skip_string(self, number: int, text: str, index: int, offset: int) -> int:
        for triple in TRIPLES:
            if text.startswith(triple, index):
                end = text.find(triple, index + 3)
                if end >= 0:
                    return end + 3
                self.block = (triple, False, number, [text[index:]])
                return len(text)
        quote = text[index]
        cursor = index + 1
        while cursor < len(text):
            if text[cursor] == "\\":
                cursor += 2
                continue
            if text[cursor] == quote:
                return cursor + 1
            cursor += 1
        return len(text)

    def comment_at(self, text: str, index: int, offset: int) -> str | None:
        syntax = self.lang.syntax
        if syntax in (Syntax.HASH, Syntax.SHELL) and text[index] == "#":
            if syntax is Syntax.SHELL and index + offset > 0:
                before = text[index - 1] if index else " "
                if before not in " \t":
                    return None
            return "#"
        if syntax is Syntax.SLASH:
            if text.startswith("//", index):
                return "//"
            if text.startswith("/*", index):
                return "/*"
            return None
        if syntax is Syntax.DASH and text.startswith("--", index):
            return "--[[" if text.startswith("--[[", index) else "--"
        return None

    def open_comment(
        self, number: int, text: str, index: int, offset: int, marker: str
    ) -> None:
        trailing = bool(text[:index].strip()) or offset > 0
        if marker in ("/*", "--[["):
            closer = "*/" if marker == "/*" else "]]"
            rest = text[index:]
            end = rest.find(closer, len(marker))
            if end >= 0:
                self.add(number, number, Kind.BLOCK, rest[: end + len(closer)], trailing)
                self.scan_line(number, rest[end + len(closer):], offset + index + end)
                return
            self.block = (closer, True, number, [rest])
            return
        raw = text[index:]
        kind = Kind.LINE
        if self.lang.syntax is Syntax.SLASH and re.match(r"^//[/!]", raw):
            kind = Kind.DOC
        self.add(number, number, kind, raw, trailing)


def mark_header(src: str, runs: list[list[Comment]]) -> None:
    """A file-level header: the first run, with nothing but blank lines above it."""
    if not runs:
        return
    lines = src.splitlines()
    first = runs[0][0].line
    if any(lines[number - 1].strip() for number in range(1, first)):
        return
    for comment in runs[0]:
        comment.header = True


def group_runs(comments: list[Comment]) -> list[list[Comment]]:
    runs: list[list[Comment]] = []
    for comment in sorted(comments, key=lambda item: item.line):
        previous = runs[-1][-1] if runs else None
        joins = (
            previous is not None
            and previous.kind is comment.kind
            and not previous.trailing
            and not comment.trailing
            and comment.line == previous.end_line + 1
        )
        if not joins:
            runs.append([])
        runs[-1].append(comment)
        comment.run = len(runs) - 1
    return runs


def extract_lex(src: str, lang: Lang) -> list[Comment]:
    return Scanner(src, lang).scan()


